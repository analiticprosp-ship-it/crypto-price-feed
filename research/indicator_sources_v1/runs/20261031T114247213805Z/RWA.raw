n a high-security duty-free vaults in Switzerland. Holdings are audited twice per year. On-chain proof-of-reserves and price oracles (USD/EUR/CHF) support transparency.\n\nChains \u0026 Integrations\nNative issuance on Polygon; bridged to other chains via LayerZero/Wormhole. Designed for DeFi: collateralization, liquidity programs, and integrations with RWA/stablecoin protocols.\n\nOperations\nMint/burn against physical inventory; redemption available per terms. KYC tiers: simplified onboarding up to CHF 1,000 per month, full KYC beyond.","daily_mints_token":{"val":1593.3723,"val_7d":1824.98,"val_30d":1824.98,"val_90d":1824.98,"chg_7d_amt":-231.60770000000002,"chg_7d_pct":-12.690971955857053,"chg_30d_amt":-231.60770000000002,"chg_30d_pct":-12.690971955857053,"chg_90d_amt":-231.60770000000002,"chg_90d_pct":-12.690971955857053},"daily_mints_dollar":{"val":85916.22778829944,"val_7d":138862.72820000167,"val_30d":138862.72820000167,"val_90d":138862.72820000167,"chg_7d_amt":-52946.50041170223,"chg_7d_pct":-38.12866209530629,"chg_30d_amt":-52946.50041170223,"chg_30d_pct":-38.12866209530629,"chg_90d_amt":-52946.50041170223,"chg_90d_pct":-38.12866209530629},"holding_addresses_count":{"val":128,"val_7d":128,"val_30d":126,"val_90d":122,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":2,"chg_30d_pct":1.5873015873015872,"chg_90d_amt":6,"chg_90d_pct":4.918032786885246},"adjusted_daily_mints_token":{"val":153.68714295,"val_7d":171.89338304,"val_30d":92.45061703,"val_90d":113.84891478,"chg_7d_amt":-18.206240089999994,"chg_7d_pct":-10.59158867433737,"chg_30d_amt":61.236525920000005,"chg_30d_pct":66.23701159304206,"chg_90d_amt":39.83822817000001,"chg_90d_pct":34.9921896462367},"bridged_token_value_dollar":{"val":1265174.020692503,"val_7d":1365335.7240027576,"val_30d":1522994.1587307611,"val_90d":1442197.0424759565,"chg_7d_amt":-100161.7033102545,"chg_7d_pct":-7.336049408903637,"chg_30d_amt":-257820.13803825807,"chg_30d_pct":-16.92850471948765,"chg_90d_amt":-177023.0217834534,"chg_90d_pct"