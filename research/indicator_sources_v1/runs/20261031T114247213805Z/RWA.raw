\nHeadquartered in Singapore, DigiFT is among the first on-chain platforms to be licensed by both the Monetary Authority of Singapore (MAS) and the Hong Kong Securities and Futures Commission (SFC)—two of Asia’s most sophisticated financial regulators.\n\nDigiFT offers a fully integrated solution for the tokenization, issuance, distribution, custody, and trading of tokenized assets—delivering both real-time and OTC institutional liquidity, fiat and stablecoin settlement, and native interoperability with public blockchains.\n\nTrusted by global financial institutions, DigiFT is the on-chain tokenization and distribution partner for leading asset managers such as Invesco, UBS, DBS Bank, CMB International, and Wellington Management—bringing to market landmark products at the forefront of institutional RWA adoption.","daily_mints_token":{"val":1395.2278,"val_7d":1395.2278,"val_30d":1395.2278,"val_90d":1395.2278,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"daily_mints_dollar":{"val":15191.240286399998,"val_7d":15191.240286399998,"val_30d":15191.240286399998,"val_90d":15191.240286399998,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"holding_addresses_count":{"val":0,"val_7d":0,"val_30d":1,"val_90d":1,"chg_7d_amt":0,"chg_7d_pct":null,"chg_30d_amt":-1,"chg_30d_pct":-100,"chg_90d_amt":-1,"chg_90d_pct":-100},"adjusted_daily_mints_token":{"val":1395.2278,"val_7d":1395.2278,"val_30d":1395.2278,"val_90d":1395.2278,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"bridged_token_value_dollar":{"val":0,"val_7d":0,"val_30d":0,"val_90d":0,"chg_7d_amt":0,"chg_7d_pct":null,"chg_30d_amt":0,"chg_30d_pct":null,"chg_90d_amt":0,"chg_90d_pct":null},"adjusted_daily_mints_dollar":{"val":15191.240286399998,"val_7d":15191.240286399998,"val_30d":15191.240286399998,"val_90d":15191.240286399998,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0