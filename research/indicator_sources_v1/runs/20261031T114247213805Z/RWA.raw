55775.941277817416},"trailing_30_day_active_addresses_count":{"val":233,"val_7d":227,"val_30d":167,"val_90d":10,"chg_7d_amt":6,"chg_7d_pct":2.643171806167401,"chg_30d_amt":66,"chg_30d_pct":39.52095808383233,"chg_90d_amt":223,"chg_90d_pct":2230}},{"id":394,"name":"OnRe","slug":"onre","icon_url":"https://rwa-partners-infra-prod-rwapartnersuploads740d2985-1c2klgo7i3ef.s3.us-east-1.amazonaws.com/uploads/images/OnRe%20Logo%20Mark.png","color_hex":"#17272b","asset_count":1,"description":"OnRe brings returns from the $750bn+ global reinsurance market into the crypto capital ecosystem, unlocking a new class of uncorrelated, real-world yield for on-chain allocators. Licensed to accept digital assets as collateral for underwriting reinsurance, OnRe delivers consistent, scalable returns to crypto markets. OnRe's reinsurance pool, denominated in sUSDe, is structured as a novel on-chain financial product designed to generate yield across market cycles. It offers a return profile that is unreplicable in TradFi, uncorrelated to crypto volatility, and enhanced by native sUSDe yield and token incentives in stronger markets. By utilizing sUSDe as collateral, OnRe offers double the upside potential of comparable traditional reinsurance investments while significantly reducing principal risk. With a focus on transparency, scalability, and capital efficiency, OnRe is transforming how capital is deployed — opening access to a market that has historically remained out of reach.","daily_mints_token":{"val":2774039.712440204,"val_7d":3814.881348477,"val_30d":418609.9605848779,"val_90d":335209.39033508406,"chg_7d_amt":2770224.8310917267,"chg_7d_pct":72616.27762545412,"chg_30d_amt":2355429.751855326,"chg_30d_pct":562.678859472035,"chg_90d_amt":2438830.32210512,"chg_90d_pct":727.5542966344713},"daily_mints_dollar":{"val":3195583.3715661257,"val_7d":4410.3481171520125,"val_30d":481652.76136537094,"val_90d":378498.2841621755,"chg_7d_amt":3191173.0234489734,"chg_7d_pct":72356.48839234207,"chg_30d