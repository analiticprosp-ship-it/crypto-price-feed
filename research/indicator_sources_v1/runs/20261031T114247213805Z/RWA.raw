nd high-stakes workflows onchain with the reliability and control they expect from traditional markets.\n\nWe are industry, model, and use-case agnostic, working across real-world assets, natural resources, infrastructure, project finance, private credit, and other complex structures. On the AI side, we design, train, and deploy enterprise models and LLM solutions and pair them with blockchain-based authenticity and data governance, so organizations get one unified stack where AI systems are powerful enough for large-scale production use and traceable, auditable, and controllable enough for regulated and mission-critical environments.","daily_mints_token":{"val":105003322.88996488,"val_7d":105003322.88996488,"val_30d":105001424.09569924,"val_90d":105000000.949368,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":1898.7942656427622,"chg_30d_pct":0.0018083509647566153,"chg_90d_amt":3321.9405968785286,"chg_90d_pct":0.0031637529208027346},"daily_mints_dollar":{"val":350011.065223583,"val_7d":350011.065223583,"val_30d":150004.74223867845,"val_90d":100.00009283544,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":200006.32298490457,"chg_30d_pct":133.33333333333331,"chg_90d_amt":349911.06513074756,"chg_90d_pct":349910.74028957216},"holding_addresses_count":{"val":38,"val_7d":38,"val_30d":34,"val_90d":3,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":4,"chg_30d_pct":11.76470588235294,"chg_90d_amt":35,"chg_90d_pct":1166.6666666666665},"adjusted_daily_mints_token":{"val":3322.889964872306,"val_7d":3322.889964872306,"val_30d":1424.0956992309884,"val_90d":0.949368,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":1898.7942656413175,"chg_30d_pct":133.33333333333331,"chg_90d_amt":3321.940596872306,"chg_90d_pct":349910.74028957216},"bridged_token_value_dollar":{"val":11059999650.000002,"val_7d":11059999650.000002,"val_30d":11059999650.000004,"val_90d":11059999650.000002,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":-0.0000019073486328125,"chg_30d_pct":-1.7245467388531964e-14,"chg_90d_amt":0,"chg_90d_pct"