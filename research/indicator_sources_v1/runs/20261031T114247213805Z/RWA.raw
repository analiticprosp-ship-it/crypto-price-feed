hort-term treasury bill product, STBT, Matrixdock has rapidly emerged as Asia’s RWA leader, earning the Ecosystem Excellence TADS Award in 2023 for Trading \u0026 Liquidity Solutions. \n\nIn 2024, Matrixdock introduced tokenized gold, XAUm, an ERC-20 token fully backed by 99.99% purity gold, offering investors a trusted and transparent digital asset tied to London Bullion Market Association (LBMA) accredited gold. The gold reserves backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":6.249218,"val_7d":0.0001,"val_30d":0.705494,"val_90d":250,"chg_7d_amt":6.249118,"chg_7d_pct":6249118,"chg_30d_amt":5.543724,"chg_30d_pct":785.7932172350155,"chg_90d_amt":-243.750782,"chg_90d_pct":-97.5003128},"daily_mints_dollar":{"val":25367.699699464796,"val_7d":0.4138183131711995,"val_30d":3000.013373176536,"val_90d":1032717.7965579155,"chg_7d_amt":25367.285881151623,"chg_7d_pct":6130053.956954052,"chg_30d_amt":22367.68632628826,"chg_30d_pct":745.5862205908918,"chg_90d_amt":-1007350.0968584507,"chg_90d_pct":-97.54359808807244},"holding_addresses_count":{"val":303,"val_7d":304,"val_30d":309,"val_90d":312,"chg_7d_amt":-1,"chg_7d_pct":-0.3289473684210526,"chg_30d_amt":-6,"chg_30d_pct":-1.9417475728155338,"chg_90d_amt":-9,"chg_90d_pct":-2.8846153846153846},"adjusted_daily_mints_token":{"val":6.249218,"val_7d":0.0001,"val_30d":0.705494,"val_90d":250,"chg_7d_amt":6.249118,"chg_7d_pct":6249118,"chg_30d_amt":5.543724,"chg_30d_pct":785.7932172350155,"chg_90d_amt":-243.750782,"chg_90d_pct":-97.5003128},"bridged_token_value_dollar":{"val":20962934.872375704,"val_7d":216148