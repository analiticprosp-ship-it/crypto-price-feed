ciation (LBMA) accredited gold. The gold reserves backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":2.185283,"val_7d":0.0001,"val_30d":0.959492,"val_90d":0.001,"chg_7d_amt":2.185183,"chg_7d_pct":2185183,"chg_30d_amt":1.225791,"chg_30d_pct":127.75416574604061,"chg_90d_amt":2.184283,"chg_90d_pct":218428.30000000005},"daily_mints_dollar":{"val":8870.80637966951,"val_7d":0.4138183131711995,"val_30d":4017.0092072000048,"val_90d":4.112276248833924,"chg_7d_amt":8870.392561356339,"chg_7d_pct":2143547.6099112597,"chg_30d_amt":4853.797172469505,"chg_30d_pct":120.83111892722722,"chg_90d_amt":8866.694103420676,"chg_90d_pct":215615.23513735036},"holding_addresses_count":{"val":2917,"val_7d":2916,"val_30d":2920,"val_90d":2937,"chg_7d_amt":1,"chg_7d_pct":0.034293552812071325,"chg_30d_amt":-3,"chg_30d_pct":-0.10273972602739725,"chg_90d_amt":-20,"chg_90d_pct":-0.6809669731018045},"adjusted_daily_mints_token":{"val":2.185283,"val_7d":0.0001,"val_30d":0.959492,"val_90d":0.001,"chg_7d_amt":2.185183,"chg_7d_pct":2185183,"chg_30d_amt":1.225791,"chg_30d_pct":127.75416574604061,"chg_90d_amt":2.184283,"chg_90d_pct":218428.30000000005},"bridged_token_value_dollar":{"val":21587209.2085523,"val_7d":22252817.36498321,"val_30d":23267292.775450382,"val_90d":22634713.950558513,"chg_7d_amt":-665608.1564309075,"chg_7d_pct":-2.991118587430198,"chg_30d_amt":-1680083.5668980815,"chg_30d_pct":-7.220795230078332,"chg_90d_amt":-1047504.7420062125,"chg_90d_pct":-4.627868257112943},"adjusted_daily_mints_dollar":{"val":8870.80637966951,"val_7d":0.4138183131711995,"val_30d":4017.00920