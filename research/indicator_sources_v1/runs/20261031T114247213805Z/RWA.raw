ility with public blockchains.\n\nTrusted by global financial institutions, DigiFT is the on-chain tokenization and distribution partner for leading asset managers such as Invesco, UBS, DBS Bank, CMB International, and Wellington Management—bringing to market landmark products at the forefront of institutional RWA adoption.","daily_mints_token":{"val":363556.6333,"val_7d":380634.5449,"val_30d":543292.9049,"val_90d":184730.5493,"chg_7d_amt":-17077.911599999992,"chg_7d_pct":-4.486695132856816,"chg_30d_amt":-179736.27159999998,"chg_30d_pct":-33.082757013563935,"chg_90d_amt":178826.08399999997,"chg_90d_pct":96.80374181618913},"daily_mints_dollar":{"val":4611174.81891028,"val_7d":6728762.4222904,"val_30d":25455633.476586398,"val_90d":21455499.576426677,"chg_7d_amt":-2117587.6033801194,"chg_7d_pct":-31.470684659116184,"chg_30d_amt":-20844458.657676116,"chg_30d_pct":-81.88544463781837,"chg_90d_amt":-16844324.7575164,"chg_90d_pct":-78.50819179257606},"holding_addresses_count":{"val":66,"val_7d":67,"val_30d":55,"val_90d":53,"chg_7d_amt":-1,"chg_7d_pct":-1.4925373134328357,"chg_30d_amt":11,"chg_30d_pct":20,"chg_90d_amt":13,"chg_90d_pct":24.528301886792452},"adjusted_daily_mints_token":{"val":363556.6333,"val_7d":380634.5449,"val_30d":543292.9049,"val_90d":184730.5493,"chg_7d_amt":-17077.911599999992,"chg_7d_pct":-4.486695132856816,"chg_30d_amt":-179736.27159999998,"chg_30d_pct":-33.082757013563935,"chg_90d_amt":178826.08399999997,"chg_90d_pct":96.80374181618913},"bridged_token_value_dollar":{"val":148202085.90523353,"val_7d":148393789.53737724,"val_30d":105921945.26792772,"val_90d":101917456.08195445,"chg_7d_amt":-191703.63214370608,"chg_7d_pct":-0.12918575146665423,"chg_30d_amt":42280140.63730581,"chg_30d_pct":39.916318124972996,"chg_90d_amt":46284629.82327908,"chg_90d_pct":45.41383939769888},"adjusted_daily_mints_dollar":{"val":4611174.81891028,"val_7d":6728762.4222904,"val_30d":25455633.476586398,"val_90d":21455499.576426677,"chg_7d_amt":-2117587.6033801194,"chg_7d_pct":-3