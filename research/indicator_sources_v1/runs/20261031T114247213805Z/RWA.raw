 backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":129156.899218,"val_7d":65624.18010000001,"val_30d":65624.885494,"val_90d":139064.04,"chg_7d_amt":63532.71911799999,"chg_7d_pct":96.81297201913533,"chg_30d_amt":63532.013724000004,"chg_30d_pct":96.81085650017425,"chg_90d_amt":-9907.140782000002,"chg_90d_pct":-7.12415717391786},"daily_mints_dollar":{"val":154518.3496994648,"val_7d":65624.59381831318,"val_30d":68624.19337317655,"val_90d":1171531.8365579154,"chg_7d_amt":88893.75588115162,"chg_7d_pct":135.4579902273543,"chg_30d_amt":85894.15632628826,"chg_30d_pct":125.16599773959909,"chg_90d_amt":-1017013.4868584506,"chg_90d_pct":-86.81057186175528},"holding_addresses_count":{"val":342,"val_7d":343,"val_30d":348,"val_90d":351,"chg_7d_amt":-1,"chg_7d_pct":-0.2915451895043732,"chg_30d_amt":-6,"chg_30d_pct":-1.7241379310344827,"chg_90d_amt":-9,"chg_90d_pct":-2.564102564102564},"adjusted_daily_mints_token":{"val":129156.899218,"val_7d":65624.18010000001,"val_30d":65624.885494,"val_90d":139064.04,"chg_7d_amt":63532.71911799999,"chg_7d_pct":96.81297201913533,"chg_30d_amt":63532.013724000004,"chg_30d_pct":96.81085650017425,"chg_90d_amt":-9907.140782000002,"chg_90d_pct":-7.12415717391786},"bridged_token_value_dollar":{"val":36481397.465416014,"val_7d":37004187.470411345,"val_30d":39150721.822434515,"val_90d":40505882.77419271,"chg_7d_amt":-522790.00499533117,"chg_7d_pct":-1.4127860675588555,"chg_30d_amt":-2669324.3570185006,"chg_30d_pct":-6.818071884153358,"chg_90d_amt":-4024485.308776699,"chg_90d_pct":-9.93555758607191},"adjusted_daily_mints_dollar":{"v