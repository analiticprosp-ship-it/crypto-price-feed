 written on, while maintaining liquid exposure through the mortgage loans which have a deep and established secondary market ($300 billion+ per day).\n\nStable Home Accounts enable homeowners to capitalize on their home equity and deploy into yield strategies. Across America over $35 Trillion in home equity sits idle. By earning just 2-3% on their home equity the average homeowner could pay off their mortgage up to a decade early. Stable Home Accounts make that possible with just a few clicks and minimal risk. Homeowners can convert their equity into USDX, which places a lien on their property, and lend it in DeFi to capture a spread between their borrow rate (USDX yield) and their lending rate (USDX borrow rate).\n\nApp: app.trystable.co\nDocs: docs.trystable.co\nWeb: trystable.co\nCA: 4AjvPXMn8YZG9saAVJvcWspg73oTFf2JmU4in4Xgpump","daily_mints_token":{"val":13.833793,"val_7d":11.01112,"val_30d":86.053437,"val_90d":10.078426,"chg_7d_amt":2.822673,"chg_7d_pct":25.634749235318477,"chg_30d_amt":-72.219644,"chg_30d_pct":-83.92418306313553,"chg_90d_amt":3.7553669999999997,"chg_90d_pct":37.2614434039601},"daily_mints_dollar":{"val":13.839054709940575,"val_7d":11.016381709940575,"val_30d":90.38348519652318,"val_90d":10.472742263634387,"chg_7d_amt":2.822673,"chg_7d_pct":25.62250541348777,"chg_30d_amt":-76.54443048658261,"chg_30d_pct":-84.68851396928328,"chg_90d_amt":3.3663124463061873,"chg_90d_pct":32.14356241722276},"holding_addresses_count":{"val":223,"val_7d":222,"val_30d":215,"val_90d":181,"chg_7d_amt":1,"chg_7d_pct":0.45045045045045046,"chg_30d_amt":8,"chg_30d_pct":3.7209302325581395,"chg_90d_amt":42,"chg_90d_pct":23.204419889502763},"adjusted_daily_mints_token":{"val":13.833793,"val_7d":11.01112,"val_30d":86.053437,"val_90d":10.078426,"chg_7d_amt":2.822673,"chg_7d_pct":25.634749235318477,"chg_30d_amt":-72.219644,"chg_30d_pct":-83.92418306313553,"chg_90d_amt":3.7553669999999997,"chg_90d_pct":37.2614434039601},"bridged_token_value_dollar":{"val":1417986.1757970054,"val_