set_count":14,"description":"WisdomTree is a global financial innovator offering a diversified suite of exchange-traded products (ETPs), model portfolios, and blockchain-enabled solutions. As a leading independent ETF provider, WisdomTree is also at the forefront of digital finance, having launched a range of blockchain-based funds spanning money markets, equities, fixed income, and asset allocation, along with tokenized assets like gold. These offerings are accessible via WisdomTree Prime® for U.S. retail investors and WisdomTree Connect™ for institutions. Through subsidiaries focused on digital asset management and money services, WisdomTree aims to enhance access, transparency, and user experience across modern financial infrastructure.","daily_mints_token":{"val":5007587.25862833,"val_7d":4276.196819632508,"val_30d":1627210.8996346297,"val_90d":5099.0566544423355,"chg_7d_amt":5003311.061808698,"chg_7d_pct":117003.7599494468,"chg_30d_amt":3380376.3589937007,"chg_30d_pct":207.74051843880366,"chg_90d_amt":5002488.201973888,"chg_90d_pct":98106.15062720834},"daily_mints_dollar":{"val":5056541.863653597,"val_7d":100229.67221779701,"val_30d":1637013.1548015017,"val_90d":5262.774089193154,"chg_7d_amt":4956312.191435801,"chg_7d_pct":4944.955003609946,"chg_30d_amt":3419528.7088520955,"chg_30d_pct":208.8882852787298,"chg_90d_amt":5051279.089564404,"chg_90d_pct":95981.30195132174},"holding_addresses_count":{"val":93,"val_7d":94,"val_30d":92,"val_90d":76,"chg_7d_amt":-1,"chg_7d_pct":-1.0638297872340425,"chg_30d_amt":1,"chg_30d_pct":1.0869565217391304,"chg_90d_amt":17,"chg_90d_pct":22.36842105263158},"adjusted_daily_mints_token":{"val":5007587.25862833,"val_7d":4276.196819632508,"val_30d":1627210.8996346297,"val_90d":5099.0566544423355,"chg_7d_amt":5003311.061808698,"chg_7d_pct":117003.7599494468,"chg_30d_amt":3380376.3589937007,"chg_30d_pct":207.74051843880366,"chg_90d_amt":5002488.201973888,"chg_90d_pct":98106.15062720834},"bridged_token_value_dollar":{"val":649369920.00546