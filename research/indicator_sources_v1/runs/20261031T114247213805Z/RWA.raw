ts. This is achieved through a network of interconnected smart contracts and an architecture designed for auditable, secure operations. Participants in the protocol gain exposure to the returns of the reinsurance sector without the traditional barriers of entry, while simultaneously benefiting from the transparency and automation enabled by blockchain.","daily_mints_token":{"val":187364.4784316495,"val_7d":4450.578907,"val_30d":250.83227155869258,"val_90d":null,"chg_7d_amt":182913.89952464952,"chg_7d_pct":4109.89004681969,"chg_30d_amt":187113.6461600908,"chg_30d_pct":74597.11822460126,"chg_90d_amt":null,"chg_90d_pct":null},"daily_mints_dollar":{"val":207568.8458931098,"val_7d":4933.986987004178,"val_30d":276.6486097781259,"val_90d":null,"chg_7d_amt":202634.85890610563,"chg_7d_pct":4106.919200229622,"chg_30d_amt":207292.19728333168,"chg_30d_pct":74929.780941094,"chg_90d_amt":null,"chg_90d_pct":null},"holding_addresses_count":{"val":50,"val_7d":22,"val_30d":13,"val_90d":null,"chg_7d_amt":28,"chg_7d_pct":127.27272727272727,"chg_30d_amt":37,"chg_30d_pct":284.61538461538464,"chg_90d_amt":null,"chg_90d_pct":null},"adjusted_daily_mints_token":{"val":187364.4784316495,"val_7d":4450.578907,"val_30d":250.83227155869258,"val_90d":null,"chg_7d_amt":182913.89952464952,"chg_7d_pct":4109.89004681969,"chg_30d_amt":187113.6461600908,"chg_30d_pct":74597.11822460126,"chg_90d_amt":null,"chg_90d_pct":null},"bridged_token_value_dollar":{"val":3145354.182517484,"val_7d":1885862.0521830984,"val_30d":1454146.1409343726,"val_90d":null,"chg_7d_amt":1259492.1303343854,"chg_7d_pct":66.78601591650784,"chg_30d_amt":1691208.0415831113,"chg_30d_pct":116.30248115890282,"chg_90d_amt":null,"chg_90d_pct":null},"adjusted_daily_mints_dollar":{"val":207568.8458931098,"val_7d":4933.986987004178,"val_30d":276.6486097781259,"val_90d":null,"chg_7d_amt":202634.85890610563,"chg_7d_pct":4106.919200229622,"chg_30d_amt":207292.19728333168,"chg_30d_pct":74929.780941094,"chg_90d_amt":null,"chg_90d_pct":null},"circul