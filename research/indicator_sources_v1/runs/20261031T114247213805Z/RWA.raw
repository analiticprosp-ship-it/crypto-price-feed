 monthly via direct-to-wallet stablecoin distributions, as well as the opportunity for additional financial upside associated with the properties in the event that additional wells are drilled or existing wells are re-worked to improve production. Token holders can also expect direct exposure to the energy sector via commodity prices for crude oil, natural gas, and other hydrocarbons being produced and sold from the wells each month.  These commodity prices are also a natural hedge against inflation.  Token holders will enjoy a headache-free, passive investment, as all asset management activities are handled by the experienced team at Mineral Vault.","daily_mints_token":{"val":10000000,"val_7d":10000000,"val_30d":10000000,"val_90d":10000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"daily_mints_dollar":null,"holding_addresses_count":{"val":5,"val_7d":5,"val_30d":5,"val_90d":5,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_token":{"val":1000000,"val_7d":1000000,"val_30d":1000000,"val_90d":1000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"bridged_token_value_dollar":{"val":3288744.9824342565,"val_7d":3288744.9824342565,"val_30d":3288744.9824342546,"val_90d":3288744.9824342546,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":1.862645149230957e-9,"chg_30d_pct":5.663695905823228e-14,"chg_90d_amt":1.862645149230957e-9,"chg_90d_pct":5.663695905823228e-14},"adjusted_daily_mints_dollar":{"val":996797.8714370688,"val_7d":996797.8714370688,"val_30d":996797.8714370688,"val_90d":996797.8714370688,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"circulating_asset_value_dollar":{"val":3288744.9824342565,"val_7d":3288744.9824342565,"val_30d":3288744.9824342546,"val_90d":3288744.9824342546,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":1.862645149230957e-9,"chg_30d_pct":