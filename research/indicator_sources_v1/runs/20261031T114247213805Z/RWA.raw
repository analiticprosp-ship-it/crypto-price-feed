","name":"Altus Opportunity Fund, LLC","slug":"altus-opportunity-fund-llc","icon_url":"https://rwa-partners-infra-prod-rwapartnersuploads740d2985-1c2klgo7i3ef.s3.us-east-1.amazonaws.com/uploads/images/Altus%20png%20logo.png","color_hex":null,"asset_count":1,"description":"The Altus Opportunity Fund blends opportunistic (i.e. distressed) and value-add properties with cash-flowing investments in order to provide investors with both current yield and upside potential. By combining these two strategies (growth equity and cash flow) into the same vehicle, the Fund is structured to provide both current returns and strong equity growth. Altus has a track record that far exceeds many of its industry peers. Since 2011, Altus has achieved a realized deal-level 33.22% IRR. The goal of this Fund is to scale all of Altus’ collective experience into a vehicle that will provide enhanced investment efficiency.","daily_mints_token":{"val":25000000,"val_7d":25000000,"val_30d":25000000,"val_90d":25000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"daily_mints_dollar":null,"holding_addresses_count":{"val":1,"val_7d":1,"val_30d":1,"val_90d":1,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_token":{"val":25000000,"val_7d":25000000,"val_30d":25000000,"val_90d":25000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"bridged_token_value_dollar":{"val":25000000,"val_7d":25000000,"val_30d":25000000,"val_90d":25000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_dollar":null,"circulating_asset_value_dollar":{"val":25000000,"val_7d":25000000,"val_30d":25000000,"val_90d":25000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"bridged_token_market_cap_dollar":null,"trailing_30_day_transfer_volume":{"val":0,"val