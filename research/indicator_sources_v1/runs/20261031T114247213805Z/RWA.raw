, yield-generating strategies into programmable, composable assets. We partner with leading asset managers to bring real-world, compliant products on-chain — balancing yield, liquidity, and regulatory alignment. Current offerings include delta-neutral arbitrage and tokenized cash strategies, with more coming soon: private equity, private credit, and multi-asset structured products. \n\nBacked by strategic investors HashKey Group and Pharos, our team combines experience from Morgan Stanley, Standard Chartered, E Fund, and more — bridging traditional finance with Web3 execution. \n\nAsseto is not just tokenizing RWA — we’re building the real yield stack: compliant, composable, and connected to the real economy.","daily_mints_token":{"val":42488676.014827,"val_7d":42488676.014827,"val_30d":42488676.014827,"val_90d":42488676.014827006,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-7.450580596923828e-9,"chg_90d_pct":-1.753545013811173e-14},"daily_mints_dollar":{"val":308308111.81156707,"val_7d":308308111.81156707,"val_30d":308308111.811567,"val_90d":308308111.811567,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":5.960464477539063e-8,"chg_30d_pct":1.9332817558760837e-14,"chg_90d_amt":5.960464477539063e-8,"chg_90d_pct":1.9332817558760837e-14},"holding_addresses_count":{"val":88,"val_7d":89,"val_30d":74,"val_90d":41,"chg_7d_amt":-1,"chg_7d_pct":-1.1235955056179776,"chg_30d_amt":14,"chg_30d_pct":18.91891891891892,"chg_90d_amt":47,"chg_90d_pct":114.6341463414634},"adjusted_daily_mints_token":{"val":42488676.014827,"val_7d":42488676.014827,"val_30d":42488676.014827,"val_90d":42488676.014827006,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-7.450580596923828e-9,"chg_90d_pct":-1.753545013811173e-14},"bridged_token_value_dollar":{"val":266860725.2908037,"val_7d":266860268.25012872,"val_30d":268302231.06308702,"val_90d":278251210.0946103,"chg_7d_amt":457.0406749844551,"chg_7d_pct":0.00017126591304932282,"chg_30d_amt":-144150