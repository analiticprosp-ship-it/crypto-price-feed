 platforms at once to tap into new investor bases. \n\nNYALA is headquartered in Berlin, Germany.","daily_mints_token":{"val":337139,"val_7d":337139,"val_30d":337139,"val_90d":175735.99999999997,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":161403.00000000003,"chg_90d_pct":91.8440160240361},"daily_mints_dollar":{"val":2660026.71,"val_7d":2660026.71,"val_30d":2660026.71,"val_90d":1386557.0399999998,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":1273469.6700000002,"chg_90d_pct":91.84401602403608},"holding_addresses_count":{"val":14,"val_7d":14,"val_30d":14,"val_90d":14,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_token":{"val":337139,"val_7d":337139,"val_30d":337139,"val_90d":175735.99999999997,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":161403.00000000003,"chg_90d_pct":91.8440160240361},"bridged_token_value_dollar":{"val":9755661.51,"val_7d":9755661.51,"val_30d":9755661.51,"val_90d":7095634.8,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":2660026.71,"chg_90d_pct":37.4882133167282},"adjusted_daily_mints_dollar":{"val":2660026.71,"val_7d":2660026.71,"val_30d":2660026.71,"val_90d":1386557.0399999998,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":1273469.6700000002,"chg_90d_pct":91.84401602403608},"circulating_asset_value_dollar":{"val":9755661.51,"val_7d":9755661.51,"val_30d":9755661.51,"val_90d":7095634.8,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":2660026.71,"chg_90d_pct":37.4882133167282},"bridged_token_market_cap_dollar":null,"trailing_30_day_transfer_volume":{"val":0,"val_7d":0,"val_30d":0,"val_90d":0,"chg_7d_amt":0,"chg_7d_pct":null,"chg_30d_amt":0,"chg_30d_pct":null,"chg_90d_amt":0,"chg_90d_pct":null},"trailing_30_day_active_addresses_count":{"val":1,"val_7d":1,"val_30d":1,"val_90d":null,"chg_7d_amt":0,"chg_7d_pct"