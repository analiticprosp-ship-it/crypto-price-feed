introduced tokenized gold, XAUm, an ERC-20 token fully backed by 99.99% purity gold, offering investors a trusted and transparent digital asset tied to London Bullion Market Association (LBMA) accredited gold. The gold reserves backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":257.1839942932129,"val_7d":257.1839942932129,"val_30d":257.1839942932129,"val_90d":32.14799880981445,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":225.03599548339844,"chg_90d_pct":700.0000118660489},"daily_mints_dollar":{"val":1040795.5286132408,"val_7d":1040795.5286132408,"val_30d":1040795.5286132408,"val_90d":129200.48963052135,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":911595.0389827194,"chg_90d_pct":705.5662417299161},"holding_addresses_count":{"val":42,"val_7d":38,"val_30d":35,"val_90d":21,"chg_7d_amt":4,"chg_7d_pct":10.526315789473683,"chg_30d_amt":7,"chg_30d_pct":20,"chg_90d_amt":21,"chg_90d_pct":100},"adjusted_daily_mints_token":{"val":257.1839942932129,"val_7d":257.1839942932129,"val_30d":257.1839942932129,"val_90d":32.14799880981445,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":225.03599548339844,"chg_90d_pct":700.0000118660489},"bridged_token_value_dollar":{"val":3985734.699517897,"val_7d":4109697.385686484,"val_30d":4302071.014844586,"val_90d":3141451.084556528,"chg_7d_amt":-123962.6861685873,"chg_7d_pct":-3.0163458409451858,"chg_30d_amt":-316336.3153266893,"chg_30d_pct":-7.353117004232368,"chg_90d_amt":844283.614961369,"chg_90d_pct":26.875593228616346},"adjusted_da