e":"Matrixdock","slug":"matrixdock","icon_url":"https://rwa-partners-infra-prod-rwapartnersuploads740d2985-1c2klgo7i3ef.s3.us-east-1.amazonaws.com/uploads/images/Matrixdock%20Icon.png","color_hex":"#eda900","asset_count":1,"description":"Founded in February 2023 by Matrixport, Matrixdock is Asia’s Real World Assets (RWA) leader that modernizes financial instruments and offers access to premium RWA through advanced tokenization technology. As the first in Asia to introduce a tokenized short-term treasury bill product, STBT, Matrixdock has rapidly emerged as Asia’s RWA leader, earning the Ecosystem Excellence TADS Award in 2023 for Trading \u0026 Liquidity Solutions. \n\nIn 2024, Matrixdock introduced tokenized gold, XAUm, an ERC-20 token fully backed by 99.99% purity gold, offering investors a trusted and transparent digital asset tied to London Bullion Market Association (LBMA) accredited gold. The gold reserves backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":225.036,"val_7d":225.036,"val_30d":225.036,"val_90d":225.036,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"daily_mints_dollar":{"val":926734.5823459167,"val_7d":926734.5823459167,"val_30d":926734.5823459167,"val_90d":926734.5823459167,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"holding_addresses_count":{"val":345,"val_7d":350,"val_30d":361,"val_90d":417,"chg_7d_amt":-5,"chg_7d_pct":-1.4285714285714286,"chg_30d_amt":-16,"chg_30d_pct":-4.43213296398892,"chg_90d_amt":-72,"chg_90d_pct":-1