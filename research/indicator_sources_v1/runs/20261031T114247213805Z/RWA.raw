ransfer_volume":{"val":0,"val_7d":0,"val_30d":0,"val_90d":0,"chg_7d_amt":0,"chg_7d_pct":null,"chg_30d_amt":0,"chg_30d_pct":null,"chg_90d_amt":0,"chg_90d_pct":null},"trailing_30_day_active_addresses_count":{"val":3,"val_7d":3,"val_30d":3,"val_90d":3,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0}},{"id":"963","name":"Stable","slug":"stable","icon_url":"https://rwa-partners-infra-prod-rwapartnersuploads740d2985-1c2klgo7i3ef.s3.us-east-1.amazonaws.com/uploads/images/stable-icon-gold%20%281%29.svg","color_hex":null,"asset_count":2,"description":"Stable's infrastructure brings the mortgage market onchain. From loan origination through TBA delivery. Stable built the mortgage backed stablecoin, USDX, to enable anyone to LP into that market.\n\nUSDX is backed by first and second lien mortgages on US properties. That means USDX is over collateralized by the properties those mortgages are written on, while maintaining liquid exposure through the mortgage loans which have a deep and established secondary market ($300 billion+ per day).\n\nStable Home Accounts enable homeowners to capitalize on their home equity and deploy into yield strategies. Across America over $35 Trillion in home equity sits idle. By earning just 2-3% on their home equity the average homeowner could pay off their mortgage up to a decade early. Stable Home Accounts make that possible with just a few clicks and minimal risk. Homeowners can convert their equity into USDX, which places a lien on their property, and lend it in DeFi to capture a spread between their borrow rate (USDX yield) and their lending rate (USDX borrow rate).\n\nApp: app.trystable.co\nDocs: docs.trystable.co\nWeb: trystable.co\nCA: 4AjvPXMn8YZG9saAVJvcWspg73oTFf2JmU4in4Xgpump","daily_mints_token":{"val":13.833793,"val_7d":11.01112,"val_30d":86.053437,"val_90d":10.078426,"chg_7d_amt":2.822673,"chg_7d_pct":25.634749235318477,"chg_30d_amt":-72.219644,"chg_30d_pct":-83.92418306313553,"chg_90d_am