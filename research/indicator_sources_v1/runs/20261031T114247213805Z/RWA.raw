","icon_url":"https://rwa-partners-infra-prod-rwapartnersuploads740d2985-1c2klgo7i3ef.s3.us-east-1.amazonaws.com/uploads/images/TG%20Group%20Logo%20%28circle%29-1.png","color_hex":null,"asset_count":2,"description":"KAIO is an institutional-grade Web3 protocol, created by WebN Group and Nomura’s Laser Digital, that enables compliant tokenization and lifecycle management of alternative investment funds. It connects asset managers with distributors while providing access to tokenized hedge funds, money market funds, and private credit strategies from managers like Brevan Howard, BlackRock, and Hamilton Lane. Through its KAIO Gateway, the platform extends these assets across multiple blockchains, offering services such as collateralized lending, automated rebalancing, and programmable compliance.","daily_mints_token":{"val":139353.76400255616,"val_7d":139353.76400255616,"val_30d":139353.76400255616,"val_90d":258640,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-119286.23599744384,"chg_90d_pct":-46.12056758329873},"daily_mints_dollar":{"val":13935376.400255613,"val_7d":13935376.400255613,"val_30d":13935376.400255613,"val_90d":25864000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-11928623.599744387,"chg_90d_pct":-46.120567583298744},"holding_addresses_count":{"val":2,"val_7d":2,"val_30d":2,"val_90d":2,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_token":{"val":139353.76400255616,"val_7d":139353.76400255616,"val_30d":139353.76400255616,"val_90d":258640,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-119286.23599744384,"chg_90d_pct":-46.12056758329873},"bridged_token_value_dollar":{"val":30819113.82594487,"val_7d":30819113.82594487,"val_30d":29798336.275535665,"val_90d":25864000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":1020777.5504092053,"chg_30d_pct":3.4256192727352373,"chg_90d_amt":4955113.825944871,"chg_90d_