026 Liquidity Solutions. \n\nIn 2024, Matrixdock introduced tokenized gold, XAUm, an ERC-20 token fully backed by 99.99% purity gold, offering investors a trusted and transparent digital asset tied to London Bullion Market Association (LBMA) accredited gold. The gold reserves backing XAUm are securely held in Brink’s high-security, fully insured vaults in Singapore and Hong Kong, enabling physical redemption. \n\nMatrixdock is dedicated to becoming the gateway for clients seeking blue-chip RWA investments. With a steadfast focus on building a trusted and secure RWA ecosystem for crypto, Matrixdock provides diversified investment opportunities while setting new standards for trust and governance in the digital asset space.","daily_mints_token":{"val":0.0002,"val_7d":0.0002,"val_30d":0.002,"val_90d":0.0001,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":-0.0018,"chg_30d_pct":-89.99999999999999,"chg_90d_amt":0.0001,"chg_90d_pct":100},"daily_mints_dollar":{"val":0.7976861607122976,"val_7d":0.7976861607122976,"val_30d":8.898611890710498,"val_90d":0.4187517486826528,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":-8.1009257299982,"chg_30d_pct":-91.03583603252746,"chg_90d_amt":0.3789344120296448,"chg_90d_pct":90.49142199924681},"holding_addresses_count":{"val":61629,"val_7d":61837,"val_30d":61919,"val_90d":62165,"chg_7d_amt":-208,"chg_7d_pct":-0.3363681937998286,"chg_30d_amt":-290,"chg_30d_pct":-0.4683538170836092,"chg_90d_amt":-536,"chg_90d_pct":-0.8622215072790155},"adjusted_daily_mints_token":{"val":0.0002,"val_7d":0.0002,"val_30d":0.002,"val_90d":0.0001,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":-0.0018,"chg_30d_pct":-89.99999999999999,"chg_90d_amt":0.0001,"chg_90d_pct":100},"bridged_token_value_dollar":{"val":63967.97920043372,"val_7d":74687.47211446567,"val_30d":78184.0415139956,"val_90d":76113.74958279582,"chg_7d_amt":-10719.492914031944,"chg_7d_pct":-14.352464490434622,"chg_30d_amt":-14216.06231356188,"chg_30d_pct":-18.182818434906675,"chg_90d_amt":-12145.770382362098,"ch