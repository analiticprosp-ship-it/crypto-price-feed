zed assets like gold. These offerings are accessible via WisdomTree Prime® for U.S. retail investors and WisdomTree Connect™ for institutions. Through subsidiaries focused on digital asset management and money services, WisdomTree aims to enhance access, transparency, and user experience across modern financial infrastructure.","daily_mints_token":{"val":0.11308780700000001,"val_7d":0.11308780700000001,"val_30d":0.11308780700000001,"val_90d":0.107546719,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0.0055410880000000134,"chg_90d_pct":5.152261316312228},"daily_mints_dollar":{"val":0.11308780700000001,"val_7d":0.11308780700000001,"val_30d":0.11308780700000001,"val_90d":0.107546719,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0.0055410880000000134,"chg_90d_pct":5.152261316312228},"holding_addresses_count":{"val":7,"val_7d":7,"val_30d":7,"val_90d":8,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":-1,"chg_90d_pct":-12.5},"adjusted_daily_mints_token":{"val":0.11308780700000001,"val_7d":0.11308780700000001,"val_30d":0.11308780700000001,"val_90d":0.107546719,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0.0055410880000000134,"chg_90d_pct":5.152261316312228},"bridged_token_value_dollar":{"val":34.686997303000005,"val_7d":34.686997303000005,"val_30d":34.686997303000005,"val_90d":34.35131418300001,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0.3356831199999988,"chg_90d_pct":0.9772060486877202},"adjusted_daily_mints_dollar":{"val":0.11308780700000001,"val_7d":0.11308780700000001,"val_30d":0.11308780700000001,"val_90d":0.107546719,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0.0055410880000000134,"chg_90d_pct":5.152261316312228},"circulating_asset_value_dollar":{"val":34.686997303000005,"val_7d":34.686997303000005,"val_30d":34.686997303000005,"val_90d":34.35131418300001,"chg_7d_amt":0,"chg_7d_pct":0,"