le construction loans, private credit, real estate instruments and other real-world assets run on the same infrastructure, with consistent controls and reporting. Issuers define the rules; T-RIZE translates them into instrument-level controls enforced in code, covering investor eligibility, transfer restrictions, issuer actions, corporate actions and lifecycle administration. On EVM networks, T-RIZE applies these controls using standards such as ERC-3643 where appropriate.\n\nT-RIZE brings independently verifiable offchain data into tokenized instruments through Chainlink, while APIs connect the platform to existing custody, fund administration and treasury systems. Onboarding is staged and typically measured in weeks.","daily_mints_token":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"daily_mints_dollar":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"holding_addresses_count":{"val":1,"val_7d":1,"val_30d":1,"val_90d":1,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_token":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"bridged_token_value_dollar":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"adjusted_daily_mints_dollar":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_30d_amt":0,"chg_30d_pct":0,"chg_90d_amt":0,"chg_90d_pct":0},"circulating_asset_value_dollar":{"val":23000000,"val_7d":23000000,"val_30d":23000000,"val_90d":23000000,"chg_7d_amt":0,"chg_7d_pct":0,"chg_3